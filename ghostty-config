# -*- mode: conf-unix; tab-width: 4; indent-tabs-mode: nil; coding: utf-8-unix; -*-
# vim:set sw=4 ts=4 sts=4 et ft=conf fdm=marker fenc=utf-8:

command = direct:/opt/homebrew/bin/fish -lP

theme = TokyoNight Night

scrollback-limit = 50000000

cursor-style               = block
cursor-style-blink         = true
shell-integration          = fish
shell-integration-features = no-cursor,no-title

macos-titlebar-style        = transparent
macos-non-native-fullscreen = false
macos-window-buttons        = visible

window-save-state        = never
window-width             = 109
window-height            = 30
window-position-x        = 340
window-position-y        = 90
window-inherit-font-size = true
window-padding-x         = 6
window-padding-y         = 4
window-padding-balance   = true
window-padding-color     = extend
minimum-contrast         = 1.1

quit-after-last-window-closed = true
confirm-close-surface         = true

font-family            = "Iosevka Term SS08"
font-family            = "IosevkaTerm Nerd Font Mono"
font-size              = 14
font-feature           = calt
font-thicken           = true
font-thicken-strength  = 80

copy-on-select          = true
mouse-hide-while-typing = true

desktop-notifications = false
bell-features = audio,title,attention

macos-option-as-alt = left

quick-terminal-position = top
quick-terminal-size     = 35%
keybind = global:cmd+backquote=toggle_quick_terminal
